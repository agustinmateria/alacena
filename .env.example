# Copiá este archivo a ".env.local" y completá los valores a medida que
# los vayan configurando en clase. La app funciona sin ninguno de estos
# (con datos de ejemplo) así que podés deployar antes de tener las keys.

# API key de Gemini. Se usa en lib/llm.js para generar el menú.
# Se consigue gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API key de Resend. Se usa en lib/enviar-plan.js para mandar el email
# con el menú completo. Se consigue en https://resend.com/api-keys
RESEND_API_KEY=

# Clave secreta de Stripe (modo test). Se usa en /api/checkout y en el
# webhook para hablar con la API de Stripe.
# Se consigue en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Secreto para verificar la firma del webhook de Stripe. En desarrollo lo
# genera el Stripe CLI al correr "stripe listen --forward-to
# localhost:3000/api/webhooks/stripe". En producción se consigue en
# https://dashboard.stripe.com/test/webhooks al crear el endpoint.
STRIPE_WEBHOOK_SECRET=

# URL pública de la app (sin barra al final). Se usa para armar las URLs
# de vuelta después de pagar (success_url y cancel_url de Stripe).
# En local: http://localhost:3000
# En Vercel: la URL de tu deploy, por ejemplo https://alacena.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
